node_modules
out/
dist/
release/
release-*/
release-feed/
.cache/
*.log
.DS_Store
.refs/
.env
.env.*
electron-builder.env
~$*

# Local ad-hoc e2e driver scripts (not pushed); the folder and README are tracked, the scripts are not
/scripts/drivers/driver.*.mjs
/probe*.mjs
/apps/shell/build/THIRD-PARTY-NOTICES.txt
/example/
/.task/
/docs-archive/
.idea/
.claude/

# Local build artifacts dropped in the repo root
/*.dmg
/*.exe
/*.zip
/windows/

# Playwright artifacts
/test-results/

.cursor/rules/git-remote.mdc
__pycache__/
/notes/
/MEMORY.md

# Local fidelity-run scratch space: production repro documents and pack caches.
# Never committable — a stray `git add -A` would push user files public.
/working_dir/

# One-off verification tests kept while chasing a fix; promote to a real test
# file (or delete) instead of committing them under this name.
_scratch-*

# Windows reserved device name: bash redirects like `> nul` create a real file
# that git cannot index on Windows ("short read while indexing nul").
/nul

# Local LLM-translation cache for scripts/add-locales.mjs — regenerable, do not commit
/scripts/.add-locales-cache.json

# Ad-hoc API response dumps left over from curl/translate debugging
/resp.json
/r[0-9]*.json

# Scratch / merge-work artifacts that leaked into the index — kept on disk
# locally, must not be pushed
/%TEMP%*
/.scratch-ai-preview/
/flagprev/
/dm-head.ts
/dm-up.ts
/se-head.ts
/se-up.ts
/sh-head.ts
/sh-up.ts
/idx-staged.ts

# OS and editor droppings
Thumbs.db
desktop.ini
*.bak
*.orig
*.rej
.vscode/
